// Configuración de Cloudflare (Worker). La página está en sitio/ y el servidor en servidor/.
{
  "name": "ingeniero-espuelistico",
  "main": "servidor/index.js",
  "compatibility_date": "2026-10-01",
  // Dominio propio (comprado en Cloudflare). Cloudflare crea solo los registros DNS y el certificado.
  // La dirección antigua ...workers.dev sigue funcionando (pedidos y avisos viejos no se pierden).
  "routes": [
    { "pattern": "ingenieroespuelistico.com", "custom_domain": true },
    { "pattern": "www.ingenieroespuelistico.com", "custom_domain": true }
  ],
  "workers_dev": true,
  // Antes de publicar, arma el catálogo del servidor con los mismos precios de la página (sitio/js/precios.js)
  "build": { "command": "node servidor/generar-catalogo.mjs && node servidor/generar-paginas.mjs" },
  // Límite de solicitudes por visitante para cotizar y pagar (evita abusos)
  "ratelimits": [
    { "name": "LIMITE", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "LIMITE_GLOBAL", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } }
  ],
  "assets": {
    "directory": "./sitio",
    "binding": "ASSETS",
    // Solo /api/... (y los videos y audios, para que el iPhone pueda adelantarlos) pasan por el servidor;
    // todo lo demás se sirve directo (gratis e ilimitado)
    "run_worker_first": ["/api/*", "/fotos/taller/*", "/resenas/*"]
  },
  // Base de pedidos y clientes (espacio KV "ie_pedidos")
  "kv_namespaces": [{ "binding": "PEDIDOS", "id": "f0afa9fa377c4c6fae242f1f57aac709" }],
  // Tareas programadas (hora UTC): carritos sin pagar cada 20 minutos y resumen diario a las 7:00 a. m. de Colombia
  "triggers": { "crons": ["*/20 * * * *", "0 12 * * *"] },
  // Workers AI: pasa a texto las notas de voz de la app de pedidos y las convierte en acciones
  "ai": { "binding": "AI" },
  // No borrar las variables que se agreguen en el panel de Cloudflare al publicar desde GitHub
  "keep_vars": true,
  // Datos NO secretos (los tokens van como "Secret" en el panel de Cloudflare, nunca aquí)
  // PAYPAL_MODO: "sandbox" mientras se prueba con claves de prueba; "live" con las claves reales
  "vars": {
    "TELEGRAM_CHAT_ID": "8408950717",
    "PAYPAL_MODO": "live"
  },
  "observability": { "enabled": true }
}
