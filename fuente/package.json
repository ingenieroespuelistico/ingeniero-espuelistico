{
  "name": "ingeniero-espuelistico-fuente",
  "private": true,
  "description": "Código fuente de los módulos compilados de la página (espuela 3D y países).",
  "scripts": {
    "build:3d": "esbuild src/entrada.js --bundle --minify --format=iife --target=es2019 --outfile=../sitio/js/espuela3d.min.js",
    "build:paises": "esbuild src/paises.js --bundle --minify --format=iife --target=es2019 --outfile=../sitio/js/paises.min.js",
    "build": "npm run build:3d && npm run build:paises"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "libphonenumber-js": "1.12.10",
    "three": "0.169.0"
  }
}
