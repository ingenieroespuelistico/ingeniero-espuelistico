# Cabeceras de seguridad (Netlify). Se aplican a todas las páginas.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self'; connect-src 'self' https://open.er-api.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self)
  Cross-Origin-Opener-Policy: same-origin

# Caché: precios, textos y estilos NO llevan caché larga (si cambias un precio, el cliente lo ve de inmediato;
# el navegador solo pregunta "¿cambió?" y si no, usa su copia). Las librerías grandes que casi nunca cambian sí.
# Ojo: no repitas una misma ruta en dos reglas, porque Cloudflare junta los valores.
/js/espuela3d.min.js
  Cache-Control: public, max-age=604800
/js/paises.min.js
  Cache-Control: public, max-age=604800
/js/lugares/*
  Cache-Control: public, max-age=604800
/fotos/*
  Cache-Control: public, max-age=86400
