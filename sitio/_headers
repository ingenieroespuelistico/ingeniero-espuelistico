# Cabeceras de seguridad (Cloudflare). Se aplican a todas las páginas.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' https://connect.facebook.net https://analytics.tiktok.com https://challenges.cloudflare.com; style-src 'self'; font-src 'self'; img-src 'self' data: blob: https://www.facebook.com https://analytics.tiktok.com https://*.tiktok.com; media-src 'self'; connect-src 'self' https://open.er-api.com https://www.facebook.com https://connect.facebook.net https://analytics.tiktok.com https://*.tiktok.com https://*.tiktokw.us; frame-src https://challenges.cloudflare.com https://www.facebook.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://www.facebook.com; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self)
  Cross-Origin-Opener-Policy: same-origin

# Caché: precios, textos y estilos NO llevan caché larga (si cambias un precio, el cliente lo ve de inmediato;
# el navegador solo pregunta "¿cambió?" y si no, usa su copia). Las librerías grandes que casi nunca cambian sí.
# Ojo: no repitas una misma ruta en dos reglas, porque Cloudflare junta los valores.
/js/espuela3d.min.js
  Cache-Control: public, max-age=604800
/js/paises.min.js
  Cache-Control: public, max-age=604800
/js/lugares/*
  Cache-Control: public, max-age=604800
/fotos/*
  Cache-Control: public, max-age=604800
/fuentes/*
  Cache-Control: public, max-age=31536000, immutable

# App de pedidos (solo para el dueño): no aparece en Google, puede usar el micrófono (notas de voz) y no se guarda en caché
/admin/*
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=()
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache
